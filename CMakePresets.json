{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "description": "MSVC debug build. Requires: cmake-msvc.cmd --preset windows-msvc-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "23",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-msvc-debug-modules",
      "displayName": "Windows MSVC Debug + all optional modules",
      "description": "MSVC debug with every optional module ON (sqlite/config/ipc/network/trading) plus the vcpkg manifest features that supply their dependencies. Exercises module + test code the default presets never compile (e.g. the IPC/network sources).",
      "inherits": "windows-msvc-debug",
      "binaryDir": "${sourceDir}/build/windows-msvc-debug-modules",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "sqlite;config;ipc;network",
        "UNIGUI_MODULE_SQLITE": "ON",
        "UNIGUI_MODULE_CONFIG": "ON",
        "UNIGUI_MODULE_IPC": "ON",
        "UNIGUI_MODULE_NETWORK": "ON",
        "UNIGUI_MODULE_TRADING": "ON"
      }
    },
    {
      "name": "windows-msvc-debug-testengine",
      "displayName": "Windows MSVC Debug + ImGui test engine",
      "description": "MSVC debug with the vcpkg imgui[test-engine] feature: imgui is rebuilt with IMGUI_ENABLE_TEST_ENGINE (hooks are no-ops until an engine attaches) and the interaction-test target (test_interaction, tests/integration_test.cc) is compiled. Dev/CI-only — the testengine manifest feature is never pulled by consumers.",
      "inherits": "windows-msvc-debug",
      "binaryDir": "${sourceDir}/build/windows-msvc-debug-testengine",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "testengine",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/ports",
        "UNIGUI_TEST_ENGINE": "ON"
      }
    },
    {
      "name": "windows-msvc-debug-no-dx11",
      "displayName": "Windows MSVC Debug (DX11 backend OFF)",
      "description": "Smoke configuration that builds with UNIGUI_BACKEND_DX11=OFF — the documented 'disable DX11' path. Guards the dx11_renderer.cc / app.cc / backend_factory references that previously failed to link with DX11 off.",
      "inherits": "windows-msvc-debug",
      "binaryDir": "${sourceDir}/build/windows-msvc-debug-no-dx11",
      "cacheVariables": {
        "UNIGUI_BACKEND_DX11": "OFF"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "description": "MSVC release build. Requires: cmake-msvc.cmd --preset windows-msvc-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "23",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-msvc-debug-asan",
      "displayName": "Windows MSVC Debug + ASAN",
      "description": "MSVC debug with AddressSanitizer (/fsanitize=address; /Oy- keeps frame pointers for readable stacks). MSVC links the ASan libs via compiler directives, so no linker flag is needed; the old GCC-spelled flags (-fno-omit-frame-pointer/-g) were ignored by cl with D9002. Running the test binaries outside a vcvars shell needs the clang_rt.asan*dynamic DLL dir (VC/Tools/MSVC/<ver>/bin/Hostx64/x64) on PATH. Note: MSVC ASan has no LeakSanitizer — leak coverage comes from the linux-asan CI lane. Requires cmake-msvc.cmd wrapper.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc-debug-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_FLAGS": "/fsanitize=address /Oy-",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-clang-tidy",
      "displayName": "Windows Clang + clang-tidy",
      "description": "Clang debug build with clang-tidy static analysis on every compile.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-clang-tidy",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy;--config-file=${sourceDir}/.clang-tidy",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-clang-coverage",
      "displayName": "Windows Clang + Coverage",
      "description": "Clang debug with source-based coverage. Run: cmake --build <dir> --target coverage",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-clang-coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate",
        "CMAKE_SHARED_LINKER_FLAGS": "-fprofile-instr-generate",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "23",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "UNIGUI_BACKEND_DX11": "OFF",
        "UNIGUI_BACKEND_DX12": "OFF"
      }
    },
    {
      "name": "linux-gcc-debug-asan",
      "displayName": "Linux GCC Debug + ASAN/UBSAN",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-gcc-debug-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "UNIGUI_BACKEND_DX11": "OFF",
        "UNIGUI_BACKEND_DX12": "OFF"
      }
    },
    {
      "name": "linux-gcc-debug-werror",
      "displayName": "Linux GCC Debug + warnings-as-errors",
      "inherits": "linux-gcc-debug",
      "binaryDir": "${sourceDir}/build/linux-gcc-debug-werror",
      "cacheVariables": {
        "UNIGUI_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-msvc-debug-werror",
      "displayName": "Windows MSVC Debug + warnings-as-errors",
      "description": "MSVC /W4 /WX strict build. Requires cmake-msvc.cmd wrapper.",
      "inherits": "windows-msvc-debug",
      "binaryDir": "${sourceDir}/build/windows-msvc-debug-werror",
      "cacheVariables": {
        "UNIGUI_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "macos-clang-debug",
      "displayName": "macOS Clang Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "23",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "UNIGUI_BACKEND_DX11": "OFF",
        "UNIGUI_BACKEND_DX12": "OFF"
      }
    },
    {
      "name": "windows-msvc-sdl3-vulkan-debug",
      "displayName": "Windows MSVC SDL3+Vulkan Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc-sdl3-vulkan-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "23",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "UNIGUI_BACKEND": "SDL3_VULKAN"
      }
    },
    {
      "name": "windows-msvc-sdl3-vulkan-release",
      "displayName": "Windows MSVC SDL3+Vulkan Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc-sdl3-vulkan-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "23",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "UNIGUI_BACKEND": "SDL3_VULKAN"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug",              "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-debug-modules",      "configurePreset": "windows-msvc-debug-modules" },
    { "name": "windows-msvc-debug-no-dx11",      "configurePreset": "windows-msvc-debug-no-dx11" },
    { "name": "windows-msvc-release",            "configurePreset": "windows-msvc-release" },
    { "name": "windows-msvc-debug-asan",         "configurePreset": "windows-msvc-debug-asan" },
    { "name": "windows-clang-tidy",              "configurePreset": "windows-clang-tidy" },
    { "name": "windows-clang-coverage",          "configurePreset": "windows-clang-coverage" },
    { "name": "linux-gcc-debug",                 "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-debug-asan",            "configurePreset": "linux-gcc-debug-asan" },
    { "name": "linux-gcc-debug-werror",          "configurePreset": "linux-gcc-debug-werror" },
    { "name": "windows-msvc-debug-werror",       "configurePreset": "windows-msvc-debug-werror" },
    { "name": "macos-clang-debug",               "configurePreset": "macos-clang-debug" },
    { "name": "windows-msvc-sdl3-vulkan-debug",  "configurePreset": "windows-msvc-sdl3-vulkan-debug" },
    { "name": "windows-msvc-sdl3-vulkan-release","configurePreset": "windows-msvc-sdl3-vulkan-release" }
  ],
  "testPresets": [
    { "name": "windows-msvc-debug",              "configurePreset": "windows-msvc-debug",              "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-debug-modules",      "configurePreset": "windows-msvc-debug-modules",      "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-debug-no-dx11",      "configurePreset": "windows-msvc-debug-no-dx11",      "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-release",            "configurePreset": "windows-msvc-release",            "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-debug-asan",         "configurePreset": "windows-msvc-debug-asan",         "output": { "outputOnFailure": true } },
    { "name": "windows-clang-tidy",              "configurePreset": "windows-clang-tidy",              "output": { "outputOnFailure": true } },
    { "name": "windows-clang-coverage",          "configurePreset": "windows-clang-coverage",          "output": { "outputOnFailure": true } },
    { "name": "linux-gcc-debug",                 "configurePreset": "linux-gcc-debug",                 "output": { "outputOnFailure": true } },
    { "name": "linux-gcc-debug-asan",            "configurePreset": "linux-gcc-debug-asan",            "output": { "outputOnFailure": true } },
    { "name": "linux-gcc-debug-werror",          "configurePreset": "linux-gcc-debug-werror",          "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-debug-werror",       "configurePreset": "windows-msvc-debug-werror",       "output": { "outputOnFailure": true } },
    { "name": "macos-clang-debug",               "configurePreset": "macos-clang-debug",               "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-sdl3-vulkan-debug",  "configurePreset": "windows-msvc-sdl3-vulkan-debug",  "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-sdl3-vulkan-release","configurePreset": "windows-msvc-sdl3-vulkan-release","output": { "outputOnFailure": true } }
  ]
}
